# ===========================================
# WallShare Production Configuration
# Copy to .env and modify as needed
# ===========================================

# --- Reverse Proxy Ports (bind to 127.0.0.1 only) ---
# These are for your host Caddy to reverse_proxy into
API_PORT=8080
FRONTEND_PORT=8880

# --- PostgreSQL ---
POSTGRES_USER=wallpaper
POSTGRES_PASSWORD=wallpaper
POSTGRES_DB=wallpaper

# --- Redis ---
REDIS_PASSWORD=

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=wallpapers

# --- JWT ---
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_HOUR=24
