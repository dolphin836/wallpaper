# ===========================================
# WallShare Production Configuration
# Copy to .env and modify as needed
# ===========================================

# --- PostgreSQL ---
POSTGRES_USER=wallpaper
POSTGRES_PASSWORD=wallpaper
POSTGRES_DB=wallpaper

# --- Redis ---
REDIS_PASSWORD=

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=wallpapers
MINIO_PUBLIC_URL=https://wallpaperexchange.com/storage

# --- JWT ---
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_HOUR=24

# --- Pinterest integration ---
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URL=https://wallpaperexchange.com/api/v1/admin/integrations/pinterest/callback
PINTEREST_SITE_URL=https://wallpaperexchange.com
PINTEREST_API_BASE_URL=https://api.pinterest.com/v5
PINTEREST_TOKEN_URL=https://api.pinterest.com/v5/oauth/token
