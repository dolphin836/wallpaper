# ===========================================
# WallShare Production Configuration
# Copy to .env and modify as needed
# ===========================================

# --- Domain & HTTPS ---
SITE_DOMAIN=localhost

# --- Exposed Ports (only Caddy is exposed) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- PostgreSQL ---
POSTGRES_USER=wallpaper
POSTGRES_PASSWORD=wallpaper
POSTGRES_DB=wallpaper

# --- Redis ---
REDIS_PASSWORD=

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=wallpapers

# --- JWT ---
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_HOUR=24
