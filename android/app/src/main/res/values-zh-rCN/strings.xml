    <string name="terms_section_acceptance_title">接受条款</string>
    <string name="terms_section_acceptance_body">访问或使用 Wallpaper Exchange 即表示你同意本服务条款。如果你不同意，请不要使用本服务。</string>
    <string name="terms_section_account_title">账号</string>
    <string name="terms_section_account_body">你需要对自己的账号、密码、上传、下载、喜欢、收藏和其他活动负责。违反条款或滥用服务的账号可能会被限制或停用。</string>
    <string name="terms_section_content_title">上传内容</string>
    <string name="terms_section_content_body">你必须拥有或取得分享所上传壁纸的权利。不得上传违法、侵权、淫秽、诽谤、威胁或其他有害内容。</string>
    <string name="terms_section_coins_title">金币和下载</string>
    <string name="terms_section_coins_body">Wallpaper Exchange 使用金币平衡上传和下载。金币价值、获得规则和消耗规则可能调整。滥用金币系统可能导致功能受限。</string>
    <string name="terms_section_contact_title">变更和联系</string>
    <string name="terms_section_contact_body">我们可能更新这些条款。更新后继续使用即表示你接受新条款。如有问题，请联系 support@wallpaperexchange.com。</string>
    <string name="privacy_section_collect_title">我们收集的信息</string>
    <string name="privacy_section_collect_body">我们会收集账号信息、上传内容、个人资料、应用活动、下载、收藏、喜欢、金币流水以及运行服务所需的技术数据。</string>
    <string name="privacy_section_use_title">信息用途</string>
    <string name="privacy_section_use_body">我们使用数据来运行 Wallpaper Exchange，同步你的资料库，处理上传和下载，维护金币，展示公开主页，改进推荐，防止滥用并提供支持。</string>
    <string name="privacy_section_share_title">共享和保留</string>
    <string name="privacy_section_share_body">公开上传和公开资料可能会被其他用户看到。我们不会出售个人数据。账号活跃期间会保留账号数据，法律或安全需要时可能保留更久。</string>
    <string name="privacy_section_rights_title">你的选择</string>
    <string name="privacy_section_rights_body">你可以编辑个人资料，并请求删除账号或更正数据。出于安全、法律或账务原因，部分记录可能需要保留。</string>
    <string name="privacy_section_contact_title">联系我们</string>
    <string name="privacy_section_contact_body">隐私问题或数据请求请联系 privacy@wallpaperexchange.com。</string>
    <string name="dmca_section_notice_title">版权通知</string>
    <string name="dmca_section_notice_body">如果你认为 Wallpaper Exchange 上的内容侵犯了你的版权，请发送通知，说明受版权保护的作品、侵权链接、联系方式以及善意声明。</string>
    <string name="dmca_section_counter_title">反通知</string>
    <string name="dmca_section_counter_body">如果你的内容被误删，可以提交反通知，提供联系方式、被移除内容，并声明你认为移除属于错误。</string>
    <string name="dmca_section_repeat_title">重复侵权</string>
    <string name="dmca_section_repeat_body">我们可能移除侵权内容，并限制或终止多次上传侵权材料的账号。</string>
    <string name="dmca_section_contact_title">DMCA 联系方式</string>
    <string name="dmca_section_contact_body">版权通知和反通知请发送至 dmca@wallpaperexchange.com。</string>
</resources>
