    <string name="legal_body_note">These documents follow your language setting. If translations differ, the English version controls.</string>
    <string name="legal_version">Version</string>
    <string name="legal_updated_terms">Updated May 8, 2026</string>
    <string name="legal_updated_dmca">Updated May 14, 2026</string>
    <string name="terms_section_acceptance_title">Acceptance</string>
    <string name="terms_section_acceptance_body">By accessing or using Wallpaper Exchange, you agree to these Terms of Service. If you do not agree, do not use the service.</string>
    <string name="terms_section_account_title">Accounts</string>
    <string name="terms_section_account_body">You are responsible for your account, password, uploads, downloads, likes, favorites, and other activity. We may suspend accounts that violate these terms or abuse the service.</string>
    <string name="terms_section_content_title">Uploaded content</string>
    <string name="terms_section_content_body">You must own or have the rights to share uploaded wallpapers. Do not upload illegal, infringing, obscene, defamatory, threatening, or otherwise harmful content.</string>
    <string name="terms_section_coins_title">Coins and downloads</string>
    <string name="terms_section_coins_body">Wallpaper Exchange uses coins to balance uploads and downloads. Coin values, earning rules, and spending rules may change. Abuse of the coin system may lead to restrictions.</string>
    <string name="terms_section_contact_title">Changes and contact</string>
    <string name="terms_section_contact_body">We may update these terms. Continued use after updates means you accept the new terms. Questions: support@wallpaperexchange.com.</string>
    <string name="privacy_section_collect_title">Information we collect</string>
    <string name="privacy_section_collect_body">We collect account information, uploaded content, profile details, app activity, downloads, favorites, likes, coin transactions, and technical data needed to operate the service.</string>
    <string name="privacy_section_use_title">How we use information</string>
    <string name="privacy_section_use_body">We use data to run Wallpaper Exchange, sync your library, process uploads and downloads, maintain coins, show public profiles, improve recommendations, prevent abuse, and provide support.</string>
    <string name="privacy_section_share_title">Sharing and retention</string>
    <string name="privacy_section_share_body">Public uploads and public profile details may be visible to others. We do not sell personal data. We keep account data while your account is active unless law or safety requires longer retention.</string>
    <string name="privacy_section_rights_title">Your choices</string>
    <string name="privacy_section_rights_body">You can edit your profile and request account deletion or data corrections. Some records may be retained where required for security, legal, or accounting reasons.</string>
    <string name="privacy_section_contact_title">Contact</string>
    <string name="privacy_section_contact_body">For privacy questions or data requests, contact privacy@wallpaperexchange.com.</string>
    <string name="dmca_section_notice_title">Copyright notices</string>
    <string name="dmca_section_notice_body">If you believe content on Wallpaper Exchange infringes your copyright, send a notice identifying the copyrighted work, the infringing URL, your contact details, and a good-faith statement.</string>
    <string name="dmca_section_counter_title">Counter notices</string>
    <string name="dmca_section_counter_body">If your content was removed by mistake, you may send a counter notice with your contact details, the removed content, and a statement under penalty of perjury that removal was mistaken.</string>
    <string name="dmca_section_repeat_title">Repeat infringement</string>
    <string name="dmca_section_repeat_body">We may remove infringing content and restrict or terminate accounts that repeatedly upload infringing material.</string>
    <string name="dmca_section_contact_title">DMCA contact</string>
    <string name="dmca_section_contact_body">Send copyright notices and counter notices to dmca@wallpaperexchange.com.</string>
