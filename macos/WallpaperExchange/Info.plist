<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.wallpaperexchange.mac</string>
    <key>CFBundleName</key>
    <string>Wallpaper Exchange</string>
    <key>CFBundleDisplayName</key>
    <string>Wallpaper Exchange</string>
    <key>CFBundleExecutable</key>
    <string>WallpaperExchange</string>
    <key>CFBundleVersion</key>
    <string>2.0.2</string>
    <key>CFBundleShortVersionString</key>
    <string>2.0.2</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- LSUIElement was true while this was a menu-bar-only helper.
         v2 promotes the app to a regular Dock-visible app so the
         redesigned main window can host Discover / Detail / Profile /
         Collections / Upload. The status-bar item still attaches in
         AppDelegate for quick actions. -->

    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.wallpaperexchange.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>wallxch</string>
            </array>
        </dict>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
