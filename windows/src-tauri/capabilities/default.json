{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions granted to the main window of the desktop client.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:tray:default",
    "shell:allow-open",
    "fs:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://wallpaperexchange.com/*" }
      ]
    }
  ]
}
